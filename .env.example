# Runtime
NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=5242880

# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
API_INTERNAL_URL=http://127.0.0.1:4000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Database (PostgreSQL required)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/pixel_store

# Security Secrets (Required in production)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
TOTP_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
SCHEDULER_SECRET=replace-with-a-random-secret
# Admin Obscured Login Route Secret (Server-only, never expose via NEXT_PUBLIC_*)
# Configures the non-default admin portal path: /admin/<ADMIN_ROUTE_SECRET>/login
ADMIN_ROUTE_SECRET=replace-with-secure-admin-route-secret

# Email Verification Provider (options: in_memory, brevo, resend)
# Leave EMAIL_PROVIDER empty or set to in_memory for local dev/testing without credentials
EMAIL_PROVIDER=in_memory
EMAIL_API_KEY=
EMAIL_FROM=noreply@pixelstore.com

# Store Settings Seed
WHATSAPP_NUMBER=+201000000000

# Initial Super Admin Seed (Used by pnpm --filter @pixel-store/api db:create-super-admin)
INITIAL_SUPER_ADMIN_NAME=Super Admin
INITIAL_SUPER_ADMIN_EMAIL=admin@pixelstore.com
INITIAL_SUPER_ADMIN_PASSWORD=replace-with-secure-admin-password
